{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "root": true,
  "files": {
    "includes": ["**"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  }
}
